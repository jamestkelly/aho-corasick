{
  "name": "@jimtkelly/aho-corasick",
  "version": "1.0.1",
  "description": "Find many literal keywords in a string in one pass. Aho–Corasick for JavaScript and TypeScript, with match positions, occurrence counts, and zero runtime dependencies.",
  "main": "./dist/trie.js",
  "types": "./dist/trie.d.ts",
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "prettier-format": "prettier --config .prettierrc 'src/**/*.ts' --write",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc --project .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "typecheck": "pnpm build && tsc -p tsconfig.test.json && tsc -p tsconfig.scripts.json",
    "bench": "pnpm run build && node scripts/benchmark.mts",
    "prepack": "pnpm run build",
    "test:package": "node scripts/test-package.mts",
    "validate": "pnpm typecheck && pnpm test && pnpm run test:package"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jamestkelly/aho-corasick.git"
  },
  "keywords": [
    "aho-corasick",
    "multi-pattern-search",
    "string-matching",
    "keyword-extraction",
    "trie",
    "typescript",
    "javascript"
  ],
  "author": "Jim Kelly",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jamestkelly/aho-corasick/issues"
  },
  "homepage": "https://github.com/jamestkelly/aho-corasick#readme",
  "devDependencies": {
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.11",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^24.19.2",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "prettier": "^3.1.0",
    "semantic-release": "^25.0.9",
    "typescript": "~5.9.3",
    "vitest": "^5.1.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
