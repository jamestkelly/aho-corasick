{
  "name": "@jimtkelly/aho-corasick",
  "version": "1.0.1",
  "description": "An implementation of the Aho-Corasick algorithm in TypeScript.",
  "main": "./dist/trie.js",
  "types": "./dist/trie.d.ts",
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "prettier-format": "prettier --config .prettierrc 'src/**/*.ts' --write",
    "build": "tsc --project .",
    "test": "pnpm run build && node --test test/*.test.cjs",
    "bench": "pnpm run build && node scripts/benchmark.cjs",
    "prepack": "pnpm run build",
    "test:package": "node scripts/test-package.mjs",
    "validate": "pnpm test && pnpm run test:package"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jamestkelly/aho-corasick.git"
  },
  "keywords": [
    "Aho-Corasick",
    "TypeScript",
    "trie",
    "string matching",
    "aho-corasick",
    "search",
    "match"
  ],
  "author": "Jim Kelly",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jamestkelly/aho-corasick/issues"
  },
  "homepage": "https://github.com/jamestkelly/aho-corasick#readme",
  "devDependencies": {
    "prettier": "^3.1.0",
    "typescript": "~5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
