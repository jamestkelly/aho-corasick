{
  "name": "@jimtkelly/aho-corasick",
  "version": "1.0.1",
  "description": "An implementation of the Aho-Corasick algorithm in TypeScript.",
  "main": "./dist/trie.js",
  "types": "./dist/trie.d.ts",
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "prettier-format": "prettier --config .prettierrc 'src/**/*.ts' --write",
    "build": "tsc --project .",
    "test": "jest",
    "prepack": "pnpm run build",
    "test:package": "node scripts/test-package.mjs",
    "validate": "pnpm test --runInBand && pnpm run test:package"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jamestkelly/aho-corasick.git"
  },
  "keywords": [
    "Aho-Corasick",
    "TypeScript",
    "trie",
    "string matching",
    "aho-corasick",
    "search",
    "match"
  ],
  "author": "Jim Kelly",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jamestkelly/aho-corasick/issues"
  },
  "homepage": "https://github.com/jamestkelly/aho-corasick#readme",
  "devDependencies": {
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.11",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/jest": "^29.5.10",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "semantic-release": "^25.0.9",
    "ts-jest": "^29.1.1",
    "typescript": "~5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
